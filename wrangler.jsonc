{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krishatech",
  "compatibility_date": "2024-09-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "exclude": [
      "node_modules/**",
      ".git/**",
      ".github/**",
      ".wrangler/**",
      ".gemini/**",
      ".vscode/**",
      "package.json",
      "package-lock.json",
      "bun.lock*",
      "wrangler.jsonc",
      ".wranglerignore",
      ".gitignore",
      "*.md",
      "*.log"
    ]
  }
}
